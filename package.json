    "bwip-js": "^4.11.4",
    "fflate": "^0.8.3",
    "geist": "^1.5.1",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
