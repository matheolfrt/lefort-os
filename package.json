{
  "name": "lefort-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "scripts/db-test.sh",
    "test:finance": "npx --yes tsx scripts/finance-test.ts",
    "test:lots": "npx --yes tsx scripts/lot-rotation-test.ts",
    "test:compare": "npx --yes tsx scripts/compare-test.ts",
    "test:reinvest": "npx --yes tsx scripts/reinvest-test.ts",
    "test:warehouse": "npx --yes tsx scripts/warehouse-test.ts",
    "test:warehouse3d": "npx --yes tsx scripts/warehouse3d-test.ts",
    "test:market": "npx --yes tsx scripts/market-test.ts",
    "test:drafts": "npx --yes tsx scripts/drafts-test.ts",
    "test:search": "npx --yes tsx scripts/stock-search-test.ts",
    "test:drafts-ai": "NODE_OPTIONS=--conditions=react-server npx --yes tsx scripts/drafts-ai-test.ts",
    "test:backup": "npx --yes tsx scripts/backup-test.ts",
    "test:label": "npx --yes tsx scripts/shipping-label-test.ts",
    "typecheck": "tsc --noEmit",
    "build:extension": "rm -f public/lefort-os-vinted.zip && cd extension && zip -qr ../public/lefort-os-vinted.zip . -x \"*.DS_Store\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
