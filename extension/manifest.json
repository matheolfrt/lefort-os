{
  "manifest_version": 3,
  "name": "Lefort OS – Vinted",
  "version": "1.0.0",
  "description": "Importe votre dressing Vinted dans Lefort OS et le resynchronise (ventes, prix, réservations).",
  "action": {
    "default_title": "Lefort OS – Vinted",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://*.vinted.net/*",
    "https://*.supabase.co/*",
    "https://*.vercel.app/*"
  ]
}
